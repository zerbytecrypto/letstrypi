{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-web3-app",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
